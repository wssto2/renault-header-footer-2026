   name: \"HeaderIcon\",\n\n        props: {\n            icon: String,\n            viewBox: { type: String, default: \"0 0 24 24\" }\n        },\n\n        computed: {\n            isUrl() {\n                return /^(https?:)?\\/\\/|^\\//.test(this.icon || \"\");\n            },\n            markup() {\n                return icons[this.icon] || \"\";\n            }\n        }\n    }\n</script>\n"],"sourceRoot":"src/components"}]}