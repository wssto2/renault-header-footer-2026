{"remainingRequest":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/grgoborac/Projects/renault-header-footer-2026/src/components/LinksPanel.vue?vue&type=script&lang=js&","dependencies":[{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/src/components/LinksPanel.vue","mtime":1791287486222},{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/cache-loader/dist/cjs.js","mtime":1791287353051},{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/babel-loader/lib/index.js","mtime":1791287353253},{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/cache-loader/dist/cjs.js","mtime":1791287353051},{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/vue-loader/lib/index.js","mtime":1791287353343}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["LinksPanel.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4BA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA","file":"LinksPanel.vue","sourceRoot":"src/components","sourcesContent":["<template>\n    <div class=\"ContentWithLinks\">\n        <div class=\"ContentWithLinks__highlight\" v-if=\"highlight\">\n            <div class=\"ContentWithLinks__highlightLinks\">\n                <p class=\"ContentWithLinks__title\">{{ highlight.title }}</p>\n                <p class=\"ContentWithLinks__highlightLink\" v-for=\"(link, linkIndex) in highlightLinks\" :key=\"linkIndex\">\n                    <HeaderIcon icon=\"arrow\" class=\"ContentWithLinks__arrow\" />\n                    <a class=\"ContentWithLinks__highlightCta\" :href=\"link.url\" :target=\"link.target || '_self'\" :rel=\"link.target === '_blank' ? 'noopener' : null\">{{ link.title }}</a>\n                </p>\n            </div>\n            <div class=\"ContentWithLinks__highlightImage\" v-if=\"highlightImage\">\n                <img :src=\"highlightImage\" alt=\"\">\n            </div>\n        </div>\n        <ul class=\"ContentWithLinks__links\">\n            <li v-for=\"(column, columnIndex) in columns\" :key=\"columnIndex\">\n                <p class=\"ContentWithLinks__linksTitle\">{{ column.title }}</p>\n                <ul class=\"ContentWithLinks__sublinks\">\n                    <li v-for=\"(link, linkIndex) in activeItems(column.children)\" :key=\"linkIndex\">\n                        <a :href=\"link.url\" :target=\"link.target || '_self'\" :rel=\"link.target === '_blank' ? 'noopener' : null\">{{ link.title }}</a>\n                    </li>\n                </ul>\n            </li>\n        </ul>\n    </div>\n</template>\n\n<script>\n    import HeaderIcon from \"@/components/HeaderIcon\";\n    import { meta, activeItems } from \"@/utils\";\n\n    export default {\n        name: \"LinksPanel\",\n        components: { HeaderIcon },\n\n        props: {\n            item: Object\n        },\n\n        computed: {\n            children() {\n                return activeItems(this.item.children);\n            },\n            // Child with meta.type \"highlight\": title + links + meta.image shown on the left.\n            highlight() {\n                return this.children.find((child) => meta(child, \"type\") === \"highlight\") || null;\n            },\n            highlightLinks() {\n                return this.highlight ? activeItems(this.highlight.children) : [];\n            },\n            highlightImage() {\n                return this.highlight ? meta(this.highlight, \"image\") : null;\n            },\n            // All other children are link columns.\n            columns() {\n                return this.children.filter((child) => meta(child, \"type\") !== \"highlight\");\n            }\n        },\n\n        methods: { activeItems }\n    }\n</script>\n"]}]}