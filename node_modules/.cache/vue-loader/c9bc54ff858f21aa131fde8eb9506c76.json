{"remainingRequest":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/grgoborac/Projects/renault-header-footer-2026/src/components/HeaderSwitch.vue?vue&type=script&lang=js&","dependencies":[{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/src/components/HeaderSwitch.vue","mtime":1791287558395},{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/babel-loader/lib/index.js","mtime":1791287353253},{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/cache-loader/dist/cjs.js","mtime":1791287353051},{"path":"/Users/grgoborac/Projects/renault-header-footer-2026/node_modules/vue-loader/lib/index.js","mtime":1791287353343}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["HeaderSwitch.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;AAiBA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"HeaderSwitch.vue","sourceRoot":"src/components","sourcesContent":["<template>\n    <div :class=\"['header-switch-container', { 'mobile-header-switch': mobile }]\">\n        <div :class=\"['header-switch', { 'is-second': activeIndex === 1 }]\" @click=\"select(activeIndex === 0 ? 1 : 0)\">\n            <div class=\"header-switch-toggle\"></div>\n        </div>\n        <div class=\"header-switch-text-container\">\n            <span\n                v-for=\"(item, itemIndex) in items.slice(0, 2)\"\n                :key=\"itemIndex\"\n                :class=\"{ active: activeIndex === itemIndex }\"\n                @click=\"select(itemIndex)\"\n            >{{ item.title }}</span>\n        </div>\n    </div>\n</template>\n\n<script>\n    import { metaBool } from \"@/utils\";\n\n    // Two-state switch (e.g. private / business customers). If the item has a url the page navigates there.\n    export default {\n        name: \"HeaderSwitch\",\n\n        props: {\n            items: Array,\n            mobile: Boolean\n        },\n\n        data() {\n            const activeIndex = this.items.findIndex((item) => metaBool(item, \"active\"));\n            return { activeIndex: activeIndex === -1 ? 0 : activeIndex };\n        },\n\n        methods: {\n            select(index) {\n                if (index === this.activeIndex) {\n                    return;\n                }\n                const item = this.items[index];\n                if (item && item.url) {\n                    window.location.href = item.url;\n                    return;\n                }\n                this.activeIndex = index;\n            }\n        }\n    }\n</script>\n"]}]}